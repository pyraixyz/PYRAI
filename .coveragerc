[run]
source = pyrai
omit =
    pyrai/db/migrations/*
    pyrai/core/logging.py
    pyrai/core/metrics.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError:
    raise AssertionError

[html]
directory = coverage_html

[xml]
output = coverage.xml 