# Application
PYRAI_CONFIG=config/development.yml
PYRAI_DEBUG=true
PYRAI_ENVIRONMENT=development

# Server
PYRAI_HOST=0.0.0.0
PYRAI_PORT=8000
PYRAI_WORKERS=1
PYRAI_RELOAD=true

# Database
DATABASE_URL=postgresql+asyncpg://pyrai:pyrai@localhost:5432/pyrai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=true

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=5

# Security
SECRET_KEY=development_secret_key_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8

# Storage
MODEL_DIR=./data/models
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=100MB

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=./logs/pyrai.log

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=true
HEALTH_CHECK_INTERVAL=30 